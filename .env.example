# Copy to .env. Local development starts without Docker using embedded PostgreSQL.
NODE_ENV=development
APP_URL=http://localhost:3000
API_PORT=4100
HOST=127.0.0.1
DEMO_MODE=true
# Required in production: DEMO_MODE=false, HTTPS APP_URL, PostgreSQL, Redis and storage.
DATABASE_URL=
REDIS_URL=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback
# 32-byte base64 key; generate with node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=lms-files
SIS_BASE_URL=
SIS_API_TOKEN=
POSTGRES_PASSWORD=
# First deployment only: existing Entra Object ID and email for the initial admin.
BOOTSTRAP_ADMIN_OID=
BOOTSTRAP_ADMIN_EMAIL=
