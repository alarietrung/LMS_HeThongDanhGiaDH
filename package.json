{
  "name": "mituni-lms",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/start.mjs",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "start": "node scripts/start.mjs --production",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "npm run typecheck -w apps/api && npm run typecheck -w apps/web"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
